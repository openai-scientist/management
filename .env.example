# Complete reference: every setting of src/management/core/config.py is listed here with its
# code default. Copy to .env.local. Lines starting with "#" are optional and off by default.
# The dev Compose file forwards only some of these; the rest apply when the API runs outside Compose.
# Name of the API, shown in the OpenAPI title.
APP_NAME=AI Research Platform API
# local, test, staging or production. staging and production enforce stricter rules.
APP_ENV=local
# Dev Compose defaults this to true; the code default is false.
DEBUG=true
# URL prefix of every route.
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://platform:platform-local-only@db:5432/platform
SESSION_SIGNING_SECRET=local-only-session-secret-change-me-32
# At least 32 characters. Production refuses a value that starts with "local-only-".
SESSION_COOKIE_NAME=platform_session
# Production requires true. SameSite=none requires true.
COOKIE_SECURE=false
# lax, strict or none.
COOKIE_SAMESITE=lax
# A session ends after this many idle minutes (default 7 days) or after SESSION_ABSOLUTE_DAYS (max 30).
SESSION_IDLE_MINUTES=10080
SESSION_ABSOLUTE_DAYS=30
# Cost of hashing a password (scrypt 2**n). Production requires at least 15.
PASSWORD_SCRYPT_LOG2_N=15
# login and register: requests per client address and process in the window below.
AUTH_SESSION_RATE_LIMIT=10
AUTH_SESSION_RATE_WINDOW_SECONDS=60
# The endpoints that take or send a one-time code share this limit, same window.
AUTH_CODE_RATE_LIMIT=20
# One-time codes emailed for sign-up and password reset.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Wrong codes, counted across reissued codes, before the purpose is locked.
OTP_LOCK_AFTER_FAILURES=10
OTP_LOCK_MINUTES=60
# Largest request body in bytes. Uploads have their own limits below.
REQUEST_MAX_BODY_BYTES=1048576
# Local browser origins; use the same hostname for frontend login and API calls.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500

# Popper is the separate service that runs the research. Leave POPPER_BASE_URL empty
# until it is available: everything except starting a run works without it.
POPPER_BASE_URL=
# Sent by the Platform to Popper in X-Service-Key.
POPPER_SERVICE_KEY=
# Expected from Popper in X-Service-Key when it calls /api/v1/internal/popper/...
POPPER_CALLBACK_KEY=
# Address Popper uses to reach this API, without the /api/v1 prefix.
PUBLIC_BASE_URL=http://localhost:8080
# Seconds to wait for one call to Popper.
POPPER_TIMEOUT_SECONDS=30
# Research engines behind the pipeline (JSON). When ENGINES is set, runs use PIPELINES and
# Popper is not used. See docs/contract/README.md. Compose forwards none of ENGINES, PIPELINES and ENGINE_CALLBACK_BASE_URL.
# ENGINES={"i2h":{"base_url":"http://i2h:8000/v1","service_key":"<32+ characters>","timeout_seconds":30}}
# PIPELINES={"default":[{"stage_key":"hypothesis","engine":"i2h"}]}
# The AI PI service (JSON, same shape as one ENGINES entry). Unset: no PI, the pipeline runs as before.
# PI_SERVICE={"base_url":"http://pi:8000","service_key":"<32+ characters>","timeout_seconds":30}
# Address engines use to call this API back, without the prefix. Empty: PUBLIC_BASE_URL.
# ENGINE_CALLBACK_BASE_URL=
# Pipeline used when a run does not name one.
DEFAULT_PIPELINE=default
# Automatic revisions an engine may make; sent to engines in the review policy of a stage run.
MAX_AUTO_REVISIONS=2
# The next three settings are validated but no code reads them yet.
MAX_ITERATIONS=3
ENGINE_HEALTH_INTERVAL_SECONDS=30
ENGINE_UNREACHABLE_ALERT_SECONDS=600
# Spending cap of a run in USD: the default, and the most a request may ask for.
RUN_DEFAULT_BUDGET_USD=5
RUN_MAX_BUDGET_USD=20
# false: the USD cap is stored but not enforced (no token prices yet). true: enforce it.
RUN_BUDGET_ENFORCED=false

# Where uploaded and produced files are kept: "local" (a Docker volume) or "r2" (Cloudflare R2).
STORAGE_BACKEND=local
# Directory of the local store. Compose mounts a volume at /app/var/storage.
STORAGE_LOCAL_ROOT=var/storage
# Upload limits in bytes (50 MiB; profile pictures 4 MiB).
DATASET_MAX_UPLOAD_BYTES=52428800
ARTIFACT_MAX_UPLOAD_BYTES=52428800
PROJECT_FILE_MAX_UPLOAD_BYTES=52428800
AVATAR_MAX_UPLOAD_BYTES=4194304
# Needed only with STORAGE_BACKEND=r2. Account ID: Cloudflare dashboard > R2 > Overview.
R2_ACCOUNT_ID=
R2_BUCKET=
# From an R2 API token with "Object Read & Write" on that bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only for a bucket with a jurisdiction, e.g. https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# A Platform Admin created when the API starts, so a fresh local stack can be used at once.
# Local development only: staging and production refuse these two settings.
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=12345@Abc

# Email is sent through Resend. Leave RESEND_API_KEY empty to write each message to the
# API log instead (local only). Key: resend.com > API Keys, "Sending access", limited
# to the verified domain.
RESEND_API_KEY=
# Must be an address on the domain verified in Resend.
EMAIL_FROM=AI Research Platform <no-reply@beyond8.io.vn>
# Seconds to wait for Resend.
EMAIL_TIMEOUT_SECONDS=10
# Frontend address put in emails as the sign-in link. Empty: emails carry no link.
APP_URL=http://localhost:3000
# How long an admin waits before sending a user's sign-in details again.
INVITE_RESEND_COOLDOWN_SECONDS=60
# How long a project invitation can be accepted after it was last sent (1 to 168).
PROJECT_INVITE_TTL_HOURS=24

# Sign-in with Google. Empty: the feature is off and its two routes answer 404.
# Google Cloud console > APIs & Services > Credentials > OAuth client ID, "Web application".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must be listed, character for character, under "Authorised redirect URIs" of that client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# Google Sheets and Google Drive data connections use the same client with a redirect URI of
# their own, listed on that client too. Empty: the two kinds are off. They also need
# APP_URL and CONNECTION_SECRET_KEY, and the Drive API and Sheets API enabled in the project.
GOOGLE_OAUTH_CONNECTIONS_REDIRECT_URI=http://localhost:8080/api/v1/connections/google/callback
# Enable Google Picker API in the SAME Google Cloud project as the OAuth client.
# Browser API key: restrict to Google Picker API and allow the frontend origin and
# https://docs.google.com/* in the Website restrictions. This is sent to the browser.
GOOGLE_PICKER_API_KEY=
# Cloud project NUMBER (digits), not its name or OAuth client ID.
GOOGLE_PICKER_APP_ID=

# Data connections (external PostgreSQL databases a project can read from). Passwords are
# encrypted with this key before they are stored. Empty: the feature is off.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or replacing the key makes every saved connection unusable until it is re-created.
CONNECTION_SECRET_KEY=
# Lets a connection point at localhost or a private address. Local development only:
# staging and production refuse it.
CONNECTION_ALLOW_PRIVATE_HOSTS=false
CONNECTION_CONNECT_TIMEOUT_SECONDS=10
CONNECTION_QUERY_TIMEOUT_SECONDS=60
# The longest an import into a dataset may take, in seconds. The proxy in front of the API
# has to allow a request this long.
CONNECTION_IMPORT_TIMEOUT_SECONDS=300
# Calls to external databases running at once, for the whole API process.
CONNECTION_MAX_CONCURRENT_QUERIES=4
# How many of those one project, and one user, may hold at once. A call that finds no free
# slot is answered 429 CONNECTION_BUSY straight away; the client retries.
CONNECTION_MAX_CONCURRENT_PER_OWNER=2
# Calls to external databases one user may start per AUTH_SESSION_RATE_WINDOW_SECONDS.
CONNECTION_PROBE_RATE_LIMIT=30
# Reads through a saved connection (browsing, previews) one user may start per window.
CONNECTION_QUERY_RATE_LIMIT=120
# Rows returned by a preview.
CONNECTION_PREVIEW_MAX_ROWS=100
# The most one BigQuery query may scan, in bytes (1 GiB). Queries are billed to the project
# of the connection by what they scan; one that would scan more is refused before it runs.
CONNECTION_BIGQUERY_MAX_BYTES_BILLED=1073741824

# Technical request telemetry is redacted and retained in the application database.
# Apply the Alembic migration before enabling this feature in a deployed API.
MONITORING_EVENT_RETENTION_DAYS=14
MONITORING_EVENT_MAX_BYTES=4096
# Error-rate alerts remain disabled until all three thresholds are deliberately configured.
MONITORING_ERROR_RATE_ALERT_THRESHOLD_PERCENT=
MONITORING_ERROR_RATE_ALERT_RECOVERY_PERCENT=
MONITORING_ERROR_RATE_ALERT_MIN_SAMPLES=
MONITORING_ERROR_RATE_ALERT_LOOKBACK_SECONDS=300
