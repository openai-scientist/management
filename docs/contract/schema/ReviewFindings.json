{
  "$defs": {
    "Anchor": {
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "locator"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "author": {
          "enum": [
            "reviewer",
            "researcher"
          ],
          "title": "Author",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/FindingCategory",
          "default": "other"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "issue": {
          "minLength": 1,
          "title": "Issue",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind",
          "default": "fix"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        }
      },
      "required": [
        "finding_id",
        "anchor",
        "severity",
        "issue",
        "author"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingCategory": {
      "enum": [
        "leakage",
        "baseline",
        "control",
        "statistics",
        "reproducibility",
        "evidence",
        "other"
      ],
      "title": "FindingCategory",
      "type": "string"
    },
    "FindingKind": {
      "enum": [
        "fix",
        "needs_evidence"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "blocking",
        "major",
        "minor"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "urn:research-contract:1.4.0:ReviewFindings",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "reviewed_artifact_id": {
      "title": "Reviewed Artifact Id",
      "type": "string"
    },
    "reviewer_model": {
      "title": "Reviewer Model",
      "type": "string"
    },
    "round": {
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    }
  },
  "required": [
    "round",
    "reviewed_artifact_id",
    "reviewer_model",
    "findings",
    "passed"
  ],
  "title": "ReviewFindings",
  "type": "object"
}
