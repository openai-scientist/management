{
  "$id": "urn:research-contract:1.0.0:Health",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "active_runs": {
      "minimum": 0,
      "title": "Active Runs",
      "type": "integer"
    },
    "checks": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "boolean"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checks"
    },
    "contract_version": {
      "title": "Contract Version",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "status": {
      "enum": [
        "ok",
        "degraded",
        "down"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "engine_version",
    "contract_version",
    "active_runs"
  ],
  "title": "Health",
  "type": "object"
}
