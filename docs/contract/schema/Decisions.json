{
  "$id": "urn:research-contract:1.2.0:Decisions",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actor": {
      "enum": [
        "user",
        "system"
      ],
      "title": "Actor",
      "type": "string"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "selection": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Selection",
      "type": "object"
    }
  },
  "required": [
    "actor"
  ],
  "title": "Decisions",
  "type": "object"
}
