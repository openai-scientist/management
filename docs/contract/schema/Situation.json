{
  "$defs": {
    "BudgetView": {
      "properties": {
        "cost_unknown": {
          "default": false,
          "title": "Cost Unknown",
          "type": "boolean"
        },
        "limit_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Limit Usd"
        },
        "spent_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Spent Usd"
        }
      },
      "required": [
        "limit_usd"
      ],
      "title": "BudgetView",
      "type": "object"
    },
    "FailureInfo": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "FailureInfo",
      "type": "object"
    },
    "PipelineStageView": {
      "properties": {
        "checkpoint": {
          "default": false,
          "title": "Checkpoint",
          "type": "boolean"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "loop_back_to": {
          "items": {
            "type": "string"
          },
          "title": "Loop Back To",
          "type": "array"
        },
        "stage_key": {
          "title": "Stage Key",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "stage_key",
        "engine"
      ],
      "title": "PipelineStageView",
      "type": "object"
    }
  },
  "$id": "urn:research-contract:1.2.0:Situation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "budget": {
      "$ref": "#/$defs/BudgetView"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "iteration": {
      "default": 1,
      "minimum": 1,
      "title": "Iteration",
      "type": "integer"
    },
    "max_iterations": {
      "minimum": 1,
      "title": "Max Iterations",
      "type": "integer"
    },
    "pipeline": {
      "items": {
        "$ref": "#/$defs/PipelineStageView"
      },
      "minItems": 1,
      "title": "Pipeline",
      "type": "array"
    },
    "stage_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage Key"
    },
    "stage_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage Run Id"
    }
  },
  "required": [
    "max_iterations",
    "pipeline",
    "budget"
  ],
  "title": "Situation",
  "type": "object"
}
