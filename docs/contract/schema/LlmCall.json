{
  "$defs": {
    "ModelRole": {
      "enum": [
        "stage",
        "review"
      ],
      "title": "ModelRole",
      "type": "string"
    }
  },
  "$id": "urn:research-contract:1.1.0:LlmCall",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "input_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Tokens"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "ok",
        "error",
        "timeout"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Tokens"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/ModelRole"
    }
  },
  "required": [
    "role",
    "provider",
    "model",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "outcome"
  ],
  "title": "LlmCall",
  "type": "object"
}
