{
  "$id": "urn:research-contract:1.3.0:BudgetView",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cost_unknown": {
      "default": false,
      "title": "Cost Unknown",
      "type": "boolean"
    },
    "limit_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Limit Usd"
    },
    "spent_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Spent Usd"
    }
  },
  "required": [
    "limit_usd"
  ],
  "title": "BudgetView",
  "type": "object"
}
