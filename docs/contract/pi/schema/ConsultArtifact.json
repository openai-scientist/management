{
  "$id": "urn:research-contract:1.2.0:ConsultArtifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "download_url": {
      "title": "Download Url",
      "type": "string"
    },
    "primary": {
      "default": false,
      "title": "Primary",
      "type": "boolean"
    },
    "role": {
      "enum": [
        "primary",
        "review",
        "recommendation",
        "input",
        "history",
        "other"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema": {
      "title": "Schema",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Bytes"
    },
    "stage_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage Key"
    },
    "stage_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage Run Id"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "artifact_id",
    "schema",
    "version",
    "sha256",
    "download_url",
    "role"
  ],
  "title": "ConsultArtifact",
  "type": "object"
}
